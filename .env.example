# ============================================================
# HUSTLEBOT v2 - Environment Configuration
# Copy to .env and fill in your actual values
# ============================================================

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# DEEPGRAM (Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key

# OPENROUTER (LLM Routing)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ELEVEN LABS (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=default_voice_id

# SUPABASE (Database)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# STRIPE (Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# BREVO (Email Marketing)
BREVO_API_KEY=your_brevo_api_key

# POSTIZ (Social Media Scheduling)
POSTIZ_API_KEY=your_postiz_api_key

# Image generation handled by OpenRouter (uses OPENROUTER_API_KEY)

# MIDJOURNEY (Premium Image Generation)
MIDJOURNEY_API_KEY=your_midjourney_api_key

# FIRECRAWL (Web Scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# SERPAPI (Google Search, Trends, News)
SERPAPI_API_KEY=your_serpapi_api_key

# GOOGLE SEARCH CONSOLE (Ranking data for your site)
GOOGLE_SEARCH_CONSOLE_KEY=your_gsc_service_account_key
GOOGLE_SEARCH_CONSOLE_PROPERTY=https://your-domain.com

# GOOGLE ANALYTICS 4 (Content performance and engagement)
GA4_API_KEY=your_ga4_service_account_key
GA4_PROPERTY_ID=your_property_id

# CLEARBIT (Lead Enrichment)
CLEARBIT_API_KEY=your_clearbit_api_key

# MEM0 (Memory Storage)
MEM0_API_KEY=your_mem0_api_key

# RENDER (Backend Deployment)
RENDER_API_KEY=your_render_api_key

# VERCEL (Frontend Deployment)
VERCEL_TOKEN=your_vercel_access_token
VERCEL_TEAM_ID=your_vercel_team_id

# AWS S3 (Image & File Storage) - OPTIONAL FOR NOW
# Storage endpoints are disabled during initial Vercel deployment
# Will integrate Supabase Storage instead
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=hustlebot-assets

# REDIS (Caching)
REDIS_URL=redis://localhost:6379

# SERVER CONFIG
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CONTENT FACTORY CONFIG
CONTENT_DOMAIN=parenting and family wellness
MAX_CONCURRENT_JOBS=3
CONTENT_FACTORY_TIMEOUT=300000

# BUDGET & TRACKING
MONTHLY_BUDGET=100
BUDGET_CURRENCY=USD
TRACK_SPEND=true

# FEATURE FLAGS
ENABLE_VOICE_INPUT=true
ENABLE_IMAGE_GENERATION=true
ENABLE_LEAD_GENERATION=true
ENABLE_LANDING_PAGE_BUILDER=true
ENABLE_EMAIL_AUTOMATION=true

# Remote MCP endpoint (/mcp/sse)
# Required to expose the MCP tools over HTTP. Without it the endpoint is not
# mounted at all. Use a long random value, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# Human approval layer
TELEGRAM_ADMIN_CHAT_ID=
APPROVAL_SPEND_THRESHOLD=5
APPROVAL_CAMPAIGN_THRESHOLD=100
APPROVAL_TTL_MS=86400000
APPROVAL_AUTO_APPROVE=false

# n8n (shared Ping OS instance on Render)
# If unset, the Day-1 test alias defaults to the live hustlebot-test webhook.
N8N_WEBHOOK_URL=
N8N_TEST_WEBHOOK_URL=https://pingos-n8n.onrender.com/webhook/hustlebot-test
# Optional JSON map of alias -> url or { "url": "...", "timeout": 10000 }
N8N_WORKFLOWS=

# RETELL (outbound voice)
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
RETELL_TEST_NUMBER=
RETELL_ALLOWED_NUMBERS=

# HEYGEN (avatar / video)
HEYGEN_API_KEY=
# Legacy alias still accepted at runtime
# HEYGENAPI_KEY=
