{
  "name": "hustlebot-v2",
  "version": "1.0.0",
  "description": "AI-powered business automation platform - builds landing pages, generates leads, creates content",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "mcp:build": "node scripts/build-mcp.js",
    "mcp:validate": "node scripts/validate-tools.js",
    "db:migrate": "node scripts/migrate.js",
    "bootstrap": "node scripts/bootstrap.js",
    "test": "node --test src/**/*.test.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build:landing": "node scripts/build-landing-page.js"
  },
  "dependencies": {
    "telegraf": "^4.14.1",
    "@deepgram/sdk": "^3.4.0",
    "openrouter-ai": "^1.0.0",
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "stripe": "^13.11.0",
    "p-queue": "^7.3.4",
    "ioredis": "^5.3.2",
    "bull": "^4.11.5",
    "node-fetch": "^3.3.2",
    "form-data": "^4.0.0",
    "cheerio": "^1.0.0-rc.12",
    "playwright": "^1.40.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
